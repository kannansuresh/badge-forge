---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import GalleryBadgeCard from '../../components/GalleryBadgeCard';

export async function getStaticPaths() {
  const gallery = await getCollection('gallery');
  return gallery.map((entry) => ({
    params: { category: entry.data.categorySlug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { categoryName, categoryDescription, badges } = entry.data;
---

<Layout
  title={`${categoryName} — BadgeCraft Gallery`}
  description={categoryDescription || `Browse ${categoryName} badges in the BadgeCraft curated gallery.`}
>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <!-- Breadcrumb -->
    <div class="text-sm breadcrumbs mb-6">
      <ul>
        <li><a href="/gallery">Gallery</a></li>
        <li>{categoryName}</li>
      </ul>
    </div>

    <div class="mb-8">
      <h1 class="text-3xl font-bold">{categoryName}</h1>
      {categoryDescription && (
        <p class="text-base-content/60 mt-2">{categoryDescription}</p>
      )}
    </div>

    <!-- Badge grid with copy + edit actions -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
      {badges.map((badge) => (
        <GalleryBadgeCard
          client:load
          badge={{
            id: badge.id,
            label: badge.label,
            message: badge.message,
            color: badge.color,
            logo: badge.logo || undefined,
            logoColor: badge.logoColor || undefined,
            style: badge.style || 'flat',
            labelColor: badge.labelColor || undefined,
          }}
        />
      ))}
    </div>

    {badges.length === 0 && (
      <div class="text-center py-20">
        <p class="text-base-content/60">No badges in this category yet.</p>
      </div>
    )}
  </div>
</Layout>
