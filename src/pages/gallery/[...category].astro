---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import BadgeCard from '../../components/BadgeCard';

export async function getStaticPaths() {
  const gallery = await getCollection('gallery');
  return gallery.map((entry) => ({
    params: { category: entry.id },
    props: { entry },
  }));
}

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const { entry } = Astro.props;
const { categoryName, categoryDescription, badges } = entry.data;
const categoryPath = entry.id;
---

<Layout title={`${categoryName} — BadgeForge Gallery`}>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-sm breadcrumbs mb-6">
      <ul>
        <li><a href={`${base}gallery`}>Gallery</a></li>
        <li>{categoryName}</li>
      </ul>
    </div>

    <div class="mb-10">
      <h1 class="text-3xl font-bold mb-2">{categoryName}</h1>
      {categoryDescription && <p class="text-base-content/60">{categoryDescription}</p>}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
      {
        badges.map((badge) => (
          <BadgeCard
            client:load
            badge={{
              id: badge.id,
              label: badge.label,
              message: badge.message,
              color: badge.color,
              logo: badge.logo ?? undefined,
              logoColor: badge.logoColor ?? undefined,
              style: badge.style,
              labelColor: badge.labelColor ?? undefined,
              categorySlug: entry.data.categorySlug || categoryPath,
              categoryName: categoryName,
            }}
          />
        ))
      }
    </div>

    {
      badges.length === 0 && (
        <div class="text-center py-20">
          <p class="text-base-content/60">No badges in this category yet.</p>
        </div>
      )
    }
  </div>
</Layout>
