---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { buildShieldsUrl } from '../../lib/storage';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const gallery = await getCollection('gallery');
const totalBadges = gallery.reduce((sum, e) => sum + e.data.badges.length, 0);
---

<Layout
  title="Gallery"
  description={`Browse ${gallery.length} curated badge categories with ${totalBadges} badges for tech stacks, project health, and social media.`}
>
  <section class="hero-glow">
    <div class="max-w-6xl mx-auto px-4 pt-12 pb-4">
      <div class="mb-12">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary/10 text-primary text-xs font-medium mb-4"
        >
          <Icon name="lucide:layout-grid" class="w-3.5 h-3.5" />
          {gallery.length} Categories
        </div>
        <h1 class="text-3xl sm:text-4xl font-bold mb-3">Discovery Gallery</h1>
        <p class="text-base-content/60 max-w-2xl text-lg">
          Curated badge collections for every part of your stack. Click a category to explore, then
          click any badge to customize it in the Forge.
        </p>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 pb-16">
    {
      gallery.length === 0 ? (
        <div class="text-center py-20">
          <div class="text-5xl mb-4">📭</div>
          <h3 class="text-xl font-semibold">No categories yet</h3>
          <p class="text-base-content/50 mt-2">
            Add JSON files to src/content/gallery/ to get started.
          </p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {gallery.map((entry) => {
            const { categoryName, categoryDescription } = entry.data;
            const categoryPath = entry.id;
            const badgeCount = entry.data.badges.length;
            const previewBadges = entry.data.badges.slice(0, 3);
            return (
              <a
                href={`${base}gallery/${categoryPath}`}
                class="card bg-base-100 border border-base-300/50 card-lift no-underline group"
              >
                <div class="card-body p-5">
                  <h2 class="card-title text-base group-hover:text-primary transition-colors">
                    {categoryName}
                  </h2>
                  {categoryDescription ? (
                    <p class="text-sm text-base-content/60 line-clamp-2">{categoryDescription}</p>
                  ) : (
                    <p class="text-sm text-base-content/40 italic">No description</p>
                  )}
                  <div class="flex flex-wrap gap-1.5 my-4 min-h-7">
                    {previewBadges.map((badge) => (
                      <img
                        src={buildShieldsUrl({
                          label: badge.label,
                          message: badge.message,
                          color: badge.color,
                          logo: badge.logo,
                          logoColor: badge.logoColor,
                          style: badge.style || 'flat',
                        })}
                        alt={`${badge.label}: ${badge.message}`}
                        class="h-5"
                        loading="lazy"
                      />
                    ))}
                  </div>
                  <div class="card-actions justify-between items-center pt-2 border-t border-base-300/30">
                    <span class="badge badge-ghost badge-sm font-mono">
                      {badgeCount} badge{badgeCount !== 1 ? 's' : ''}
                    </span>
                    <span class="text-xs text-primary font-medium flex items-center gap-1 group-hover:gap-2 transition-all">
                      Browse <Icon name="lucide:arrow-right" class="w-3 h-3" />
                    </span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )
    }
  </section>
</Layout>
