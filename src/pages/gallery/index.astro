---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL;
const gallery = await getCollection('gallery');
const esc = (s: string) => encodeURIComponent(s.replace(/-/g, '--').replace(/_/g, '__'));
---

<Layout
  title="Gallery — BadgeForge"
  description="Browse curated badge categories for tech stacks, project health, and social media."
>
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="mb-12">
      <h1 class="text-3xl font-bold mb-2">Discovery Gallery</h1>
      <p class="text-base-content/60 max-w-2xl">
        Curated badge collections. Click a category to explore, then click any badge to customize it
        in the Forge.
      </p>
    </div>

    {
      gallery.length === 0 ? (
        <div class="text-center py-20">
          <div class="text-5xl mb-4">📭</div>
          <h3 class="text-xl font-semibold">No gallery categories yet</h3>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {gallery.map((entry) => {
            const { categoryName, categorySlug, categoryDescription } = entry.data;
            const badgeCount = entry.data.badges.length;
            const previewBadges = entry.data.badges.slice(0, 3);
            return (
              <a
                href={`${base}gallery/${categorySlug}`}
                class="card bg-base-100 shadow-sm border border-base-300 hover:shadow-md transition-shadow no-underline"
              >
                <div class="card-body">
                  <h2 class="card-title">{categoryName}</h2>
                  {categoryDescription && (
                    <p class="text-sm text-base-content/60 line-clamp-2">{categoryDescription}</p>
                  )}
                  <div class="flex flex-wrap gap-1.5 my-3 min-h-7">
                    {previewBadges.map((badge) => (
                      <img
                        src={`https://img.shields.io/badge/${esc(badge.label)}-${esc(badge.message)}-${badge.color}?style=${badge.style || 'flat'}${badge.logo ? `&logo=${badge.logo}` : ''}${badge.logoColor ? `&logoColor=${badge.logoColor}` : ''}`}
                        alt={`${badge.label}: ${badge.message}`}
                        class="h-5"
                        loading="lazy"
                      />
                    ))}
                  </div>
                  <div class="card-actions justify-between items-center">
                    <span class="badge badge-outline badge-sm">
                      {badgeCount} badge{badgeCount !== 1 ? 's' : ''}
                    </span>
                    <span class="text-sm text-primary font-medium">Browse →</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )
    }
  </div>
</Layout>
