---
import Layout from '../../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import GalleryBadgeDetail from '../../../components/GalleryBadgeDetail.astro';

export async function getStaticPaths() {
  const gallery = await getCollection('gallery');
  const paths: Array<{
    params: { category: string; badge: string };
    props: Record<string, unknown>;
  }> = [];

  for (const entry of gallery) {
    for (const badge of entry.data.badges) {
      paths.push({
        params: { category: entry.id, badge: badge.id },
        props: {
          label: badge.label,
          message: badge.message,
          color: badge.color,
          logo: badge.logo ?? undefined,
          logoColor: badge.logoColor ?? undefined,
          logoSize: badge.logoSize ?? undefined,
          style: badge.style ?? 'flat',
          labelColor: badge.labelColor ?? undefined,
          categorySlug: entry.id,
          categoryName: entry.data.categoryName,
          dexieSlug: entry.data.categorySlug,
        },
      });
    }
  }
  return paths;
}

const props = Astro.props;
---

<Layout title={`${props.label}: ${props.message} — BadgeForge`}>
  <div class="max-w-4xl mx-auto px-4 py-12">
    <GalleryBadgeDetail {...props} />
  </div>
</Layout>
