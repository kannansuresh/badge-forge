---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="BadgeCraft — Build Beautiful Shields.io Badges"
  description="Create, customize, and browse stunning markdown/HTML badges powered by shields.io. Local-first, developer-focused."
>
  <!-- ── Hero Section ──────────────────────────────── -->
  <section class="relative overflow-hidden">
    <div class="max-w-5xl mx-auto px-4 py-20 sm:py-28 text-center">
      <div class="mb-8 inline-flex items-center gap-2 px-4 py-2 bg-primary/10 text-primary rounded-full text-sm font-medium">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
        </span>
        v1.0 — Now with Simple Icons integration
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-6">
        Craft Beautiful
        <span class="text-primary block sm:inline"> README Badges</span>
      </h1>
      <p class="text-lg sm:text-xl text-base-content/70 max-w-2xl mx-auto mb-10">
        A lightning-fast, local-first badge builder. Search thousands of brand icons,
        customize colors and styles, and copy ready-to-use Markdown or HTML — all from your browser.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
        <a href="/builder" class="btn btn-primary btn-lg gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
          </svg>
          Open Live Studio
        </a>
        <a href="/gallery" class="btn btn-outline btn-lg gap-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          Browse Gallery
        </a>
      </div>

      <!-- Badge previews carousel -->
      <div class="flex flex-wrap justify-center gap-4 opacity-70">
        <img src="https://img.shields.io/badge/Frontend-React-61DAFB?style=flat&logo=react&logoColor=white" alt="React badge" class="h-5 sm:h-6" loading="lazy" />
        <img src="https://img.shields.io/badge/Style-Tailwind_CSS-06B6D4?style=flat&logo=tailwindcss&logoColor=white" alt="Tailwind badge" class="h-5 sm:h-6" loading="lazy" />
        <img src="https://img.shields.io/badge/Language-TypeScript-3178C6?style=flat&logo=typescript&logoColor=white" alt="TypeScript badge" class="h-5 sm:h-6" loading="lazy" />
        <img src="https://img.shields.io/badge/Build-Passing-22C55E?style=flat&logo=githubactions&logoColor=white" alt="Build passing badge" class="h-5 sm:h-6" loading="lazy" />
        <img src="https://img.shields.io/badge/License-MIT-22C55E?style=flat&logo=open-source-initiative&logoColor=white" alt="MIT badge" class="h-5 sm:h-6" loading="lazy" />
      </div>
    </div>

    <!-- Background decoration -->
    <div class="absolute inset-0 -z-10 opacity-10">
      <div class="absolute top-20 left-10 w-72 h-72 bg-primary rounded-full blur-3xl"></div>
      <div class="absolute bottom-10 right-10 w-96 h-96 bg-secondary rounded-full blur-3xl"></div>
    </div>
  </section>

  <!-- ── Features Section ───────────────────────────── -->
  <section class="bg-base-200 py-20">
    <div class="max-w-6xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-center mb-12">Why BadgeCraft?</h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Feature 1 -->
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body">
            <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center mb-3">
              <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 class="card-title">Real-Time Preview</h3>
            <p class="text-base-content/70">
              Magified and actual-size dual preview canvas. See exactly how your badge renders before you commit.
            </p>
          </div>
        </div>

        <!-- Feature 2 -->
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body">
            <div class="w-12 h-12 rounded-lg bg-success/10 flex items-center justify-center mb-3">
              <svg class="w-6 h-6 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
            </div>
            <h3 class="card-title">3,400+ Brand Icons</h3>
            <p class="text-base-content/70">
              Smart search powered by Simple Icons. Pick an icon and auto-populate its official brand hex color.
            </p>
          </div>
        </div>

        <!-- Feature 3 -->
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body">
            <div class="w-12 h-12 rounded-lg bg-warning/10 flex items-center justify-center mb-3">
              <svg class="w-6 h-6 text-warning" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <h3 class="card-title">Local-First & Private</h3>
            <p class="text-base-content/70">
              Everything stays in your browser via IndexedDB. No accounts, no servers, no tracking. Export and import JSON snapshots.
            </p>
          </div>
        </div>

        <!-- Feature 4 -->
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body">
            <div class="w-12 h-12 rounded-lg bg-info/10 flex items-center justify-center mb-3">
              <svg class="w-6 h-6 text-info" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
              </svg>
            </div>
            <h3 class="card-title">One-Click Copy</h3>
            <p class="text-base-content/70">
              Instant Markdown, HTML, and raw URL copy buttons. Paste directly into your README or profile.
            </p>
          </div>
        </div>

        <!-- Feature 5 -->
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body">
            <div class="w-12 h-12 rounded-lg bg-secondary/10 flex items-center justify-center mb-3">
              <svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
              </svg>
            </div>
            <h3 class="card-title">Curated Gallery</h3>
            <p class="text-base-content/70">
              Browse preset categories like Tech Stack, Project Health, and Social. Click to instantly customize any badge.
            </p>
          </div>
        </div>

        <!-- Feature 6 -->
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body">
            <div class="w-12 h-12 rounded-lg bg-accent/10 flex items-center justify-center mb-3">
              <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
              </svg>
            </div>
            <h3 class="card-title">Light & Dark Mode</h3>
            <p class="text-base-content/70">
              Respects your system preference with a manual override. Powered by DaisyUI semantic theming.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── CTA Section ─────────────────────────────────── -->
  <section class="py-20">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-4">Ready to build your first badge?</h2>
      <p class="text-base-content/70 mb-8">
        No sign-up required. Your badges stay private in your browser.
      </p>
      <a href="/builder" class="btn btn-primary btn-lg gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        Launch Live Studio
      </a>
    </div>
  </section>
</Layout>
