---
import { Icon } from 'astro-icon/components';
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Compute real stats from gallery content
const gallery = await getCollection('gallery');
const categoryCount = gallery.length;
const totalBadges = gallery.reduce((sum, entry) => sum + entry.data.badges.length, 0);

// Simple icons v16+ ships ~3,500 icons — get actual count from package
let iconCount = 3400; // fallback
try {
  const iconsMod = await import('simple-icons/icons.json');
  const icons = Array.isArray(iconsMod.default) ? iconsMod.default : iconsMod;
  if (Array.isArray(icons)) iconCount = icons.length;
} catch {
  /* keep fallback */
}
---

<Layout
  description="A lightning-fast, local-first badge builder for developers. Create beautiful shields.io badges with 3,400+ brand icons — no accounts, no tracking."
>
  <!-- ── Hero ──────────────────────────────────────────── -->
  <section class="hero-glow relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 pt-20 pb-24 sm:pt-28 sm:pb-32 text-center">
      <!-- Status badge -->
      <div
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-primary/10 text-primary text-sm font-medium mb-8"
      >
        <span class="relative flex h-2 w-2">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
          ></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-primary"></span>
        </span>
        v1.0 • {iconCount.toLocaleString()}+ Brand Icons
      </div>

      <h1
        class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold tracking-tight leading-tight mb-6 max-w-5xl mx-auto"
      >
        Craft beautiful
        <span class="gradient-text">README badges</span>
        <br class="hidden sm:block" />
        in seconds
      </h1>

      <p class="text-lg sm:text-xl text-base-content/60 max-w-2xl mx-auto mb-10 leading-relaxed">
        A lightning-fast, local-first badge builder. Search thousands of brand icons, customize
        every detail, and copy ready-to-use Markdown or HTML — all from your browser.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
        <a href={`${base}builder`} class="btn btn-primary btn-lg shadow-lg shadow-primary/25">
          <Icon name="lucide:wand-sparkles" class="w-5 h-5" />
          Open Forge
        </a>
        <a href={`${base}gallery`} class="btn btn-outline btn-lg">
          <Icon name="lucide:layout-grid" class="w-5 h-5" />
          Browse Gallery
        </a>
      </div>

      <!-- Live preview badges -->
      <div class="flex flex-wrap justify-center gap-3 opacity-70">
        <img
          src="https://img.shields.io/badge/Frontend-React-61DAFB?style=for-the-badge&logo=react&logoColor=white"
          alt="React badge"
          class="h-7"
          loading="lazy"
        />
        <img
          src="https://img.shields.io/badge/Style-Tailwind-06B6D4?style=for-the-badge&logo=tailwindcss&logoColor=white"
          alt="Tailwind badge"
          class="h-7"
          loading="lazy"
        />
        <img
          src="https://img.shields.io/badge/Code-TypeScript-3178C6?style=for-the-badge&logo=typescript&logoColor=white"
          alt="TypeScript badge"
          class="h-7"
          loading="lazy"
        />
        <img
          src="https://img.shields.io/badge/Build-Passing-22C55E?style=for-the-badge&logo=githubactions&logoColor=white"
          alt="Build badge"
          class="h-7"
          loading="lazy"
        />
        <img
          src="https://img.shields.io/badge/License-MIT-22C55E?style=for-the-badge"
          alt="MIT badge"
          class="h-7"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ── Stats ─────────────────────────────────────────── -->
  <section class="border-y border-base-300/50 bg-base-200/30">
    <div class="max-w-5xl mx-auto px-4 py-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="text-3xl font-bold text-primary">{iconCount.toLocaleString()}+</div>
          <div class="text-sm text-base-content/60 mt-1">Brand Icons</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-secondary">{categoryCount}</div>
          <div class="text-sm text-base-content/60 mt-1">
            Categor{categoryCount === 1 ? 'y' : 'ies'}
          </div>
        </div>
        <div>
          <div class="text-3xl font-bold text-accent">{totalBadges.toLocaleString()}</div>
          <div class="text-sm text-base-content/60 mt-1">Curated Badges</div>
        </div>
        <div>
          <div class="text-3xl font-bold text-success">0</div>
          <div class="text-sm text-base-content/60 mt-1">Data Collected</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Features ─────────────────────────────────────── -->
  <section class="py-24">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold mb-4">
          Why <span class="gradient-text">BadgeForge</span>?
        </h2>
        <p class="text-base-content/60 text-lg max-w-xl mx-auto">
          Built for developers who care about their README
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {
          [
            {
              icon: 'lucide:eye',
              color: 'text-primary',
              bg: 'bg-primary/10',
              title: 'Real-Time Preview',
              desc: 'Magnified and actual-size dual canvas. See exactly how your badge renders before committing.',
            },
            {
              icon: 'lucide:package',
              color: 'text-success',
              bg: 'bg-success/10',
              title: '3,400+ Brand Icons',
              desc: 'Smart fuzzy search with auto-complete. Pick a logo to auto-populate its official brand color.',
            },
            {
              icon: 'lucide:shield-check',
              color: 'text-warning',
              bg: 'bg-warning/10',
              title: '100% Local & Private',
              desc: 'Everything stays in your browser via IndexedDB. No accounts, servers, or tracking — ever.',
            },
            {
              icon: 'lucide:clipboard-copy',
              color: 'text-info',
              bg: 'bg-info/10',
              title: 'One-Click Copy',
              desc: 'Markdown, HTML, URL, reST, AsciiDoc, Textile. Paste directly into your README or docs.',
            },
            {
              icon: 'lucide:layout-grid',
              color: 'text-secondary',
              bg: 'bg-secondary/10',
              title: 'Curated Gallery',
              desc: 'Browse 50+ categories of pre-made badges. Click any to customize it instantly in the Forge.',
            },
            {
              icon: 'lucide:sun-moon',
              color: 'text-accent',
              bg: 'bg-accent/10',
              title: 'Light & Dark Modes',
              desc: 'Respects your system preference with manual override. Beautiful in both themes.',
            },
          ].map((feature) => (
            <div class="card bg-base-100 border border-base-300/50 card-lift">
              <div class="card-body">
                <div
                  class={`w-10 h-10 rounded-xl ${feature.bg} flex items-center justify-center mb-2`}
                >
                  <Icon name={feature.icon} class={`w-5 h-5 ${feature.color}`} />
                </div>
                <h3 class="card-title text-lg">{feature.title}</h3>
                <p class="text-base-content/60 text-sm leading-relaxed">{feature.desc}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── CTA ──────────────────────────────────────────── -->
  <section class="py-24 bg-base-200/50 border-t border-base-300/50">
    <div class="max-w-2xl mx-auto px-4 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold mb-4">Ready to build?</h2>
      <p class="text-base-content/60 text-lg mb-8">
        No sign-up required. Your badges stay private in your browser. Forever free.
      </p>
      <a href={`${base}builder`} class="btn btn-primary btn-lg shadow-lg shadow-primary/25">
        <Icon name="lucide:wand-sparkles" class="w-5 h-5" />
        Launch Forge
      </a>
    </div>
  </section>
</Layout>
