---
import { Icon } from 'astro-icon/components';
import { Font } from 'astro:assets';
import ThemeController from '../components/ThemeController.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const title = Astro.props.title || 'BadgeCraft — Build Beautiful Shields.io Badges';
const description = Astro.props.description || 'Create, customize, and browse stunning markdown/HTML badges powered by shields.io. Local-first, developer-focused.';
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />

    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-base-100 text-base-content flex flex-col font-sans">
    <!-- Navbar -->
    <div class="navbar bg-base-100 border-b border-base-300 sticky top-0 z-50 backdrop-blur-sm">
      <div class="navbar-start">
        <!-- Mobile dropdown -->
        <div class="dropdown">
          <label tabindex="0" class="btn btn-ghost lg:hidden">
            <Icon name="lucide:menu" class="w-5 h-5" />
          </label>
          <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-10 p-2 shadow bg-base-100 rounded-box w-52">
            <li><a href="/" class:list={['', currentPath === '/' && 'menu-active']}>Home</a></li>
            <li><a href="/builder" class:list={['', currentPath === '/builder' && 'menu-active']}>Live Studio</a></li>
            <li><a href="/gallery" class:list={['', currentPath.startsWith('/gallery') && 'menu-active']}>Gallery</a></li>
            <li><a href="/dashboard" class:list={['', currentPath === '/dashboard' && 'menu-active']}>My Backpack</a></li>
          </ul>
        </div>

        <a href="/" class="btn btn-ghost text-xl font-bold gap-2">
          <span class="text-primary">🛡️</span>
          BadgeCraft
        </a>
      </div>

      <div class="navbar-center hidden lg:flex">
        <ul class="menu menu-horizontal px-1 gap-1 text-sm font-medium">
          <li><a href="/builder" class:list={['', currentPath === '/builder' && 'menu-active']}>Live Studio</a></li>
          <li><a href="/gallery" class:list={['', currentPath.startsWith('/gallery') && 'menu-active']}>Gallery</a></li>
          <li><a href="/dashboard" class:list={['', currentPath === '/dashboard' && 'menu-active']}>My Backpack</a></li>
        </ul>
      </div>

      <div class="navbar-end gap-1">
        <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-circle" aria-label="GitHub">
          <Icon name="lucide:github" class="w-5 h-5" />
        </a>
        <ThemeController />
      </div>
    </div>

    <!-- Main -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="footer sm:footer-horizontal bg-base-200 text-base-content p-10">
      <nav>
        <h6 class="footer-title">BadgeCraft</h6>
        <a href="/builder" class="link link-hover">Live Studio</a>
        <a href="/gallery" class="link link-hover">Gallery</a>
        <a href="/dashboard" class="link link-hover">My Backpack</a>
      </nav>
      <nav>
        <h6 class="footer-title">Powered by</h6>
        <a href="https://shields.io" class="link link-hover" target="_blank">shields.io</a>
        <a href="https://simpleicons.org" class="link link-hover" target="_blank">Simple Icons</a>
        <a href="https://astro.build" class="link link-hover" target="_blank">Astro</a>
      </nav>
      <nav>
        <h6 class="footer-title">Stack</h6>
        <span class="text-base-content/60 text-sm">Astro · React · Tailwind</span>
        <span class="text-base-content/60 text-sm">DaisyUI · Dexie.js</span>
        <span class="text-base-content/60 text-sm">Simple Icons · Bun</span>
      </nav>
    </footer>
  </body>
</html>
