---
import { Icon } from 'astro-icon/components';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import ThemeController from '../components/ThemeController.astro';
import Search from '../components/Search.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const siteTitle = 'BadgeForge — Build Beautiful Shields.io Badges';
const title = Astro.props.title || siteTitle;
const description =
  Astro.props.description ||
  'Create, customize, and browse stunning markdown/HTML badges powered by shields.io. Local-first, developer-focused.';
const image = Astro.props.image || `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}favicon.svg`;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const currentPath = Astro.url.pathname;

interface NavItem {
  label: string;
  href: string;
  match: (p: string) => boolean;
}
const navItems: NavItem[] = [
  { label: 'Home', href: base, match: (p) => p === '/' },
  { label: 'Forge', href: `${base}forge`, match: (p) => p === '/forge' },
  { label: 'Gallery', href: `${base}gallery`, match: (p) => p.startsWith('/gallery') },
  {
    label: 'My Badges',
    href: `${base}my-badges`,
    match: (p) => p === '/my-badges' || p === '/badge',
  },
];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Primary Meta -->
    <title>{title === siteTitle ? title : `${title} — BadgeForge`}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link
      rel="canonical"
      href={new URL(Astro.url.pathname, Astro.site || 'https://badgeforge.dev').href}
    />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={image} />
    <meta
      property="og:url"
      content={new URL(Astro.url.pathname, Astro.site || 'https://badgeforge.dev').href}
    />
    <meta property="og:site_name" content="BadgeForge" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}favicon.svg`} />

    <!-- Structured Data -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "BadgeForge",
        "description": "A local-first web app for creating and browsing shields.io badges",
        "url": "https://badgeforge.dev",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "Web",
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
      }
    </script>

    <!-- Anti-flash theme bootstrap: runs on load AND after ClientRouter swaps -->
    <script is:inline>
      function applyStoredTheme() {
        const s = localStorage.getItem('theme');
        const t =
          s === 'dark' || s === 'light'
            ? s
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', t);
      }
      applyStoredTheme();
      document.addEventListener('astro:after-swap', applyStoredTheme);
    </script>

    <ClientRouter />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />
  </head>

  <body class="min-h-screen bg-base-100 text-base-content flex flex-col font-sans">
    <!-- Navbar — glass morphism -->
    <header
      class="sticky top-0 z-50 border-b border-base-300/50 bg-base-100/80 backdrop-blur-xl"
      data-pagefind-ignore
    >
      <div class="navbar max-w-7xl mx-auto px-4">
        <div class="navbar-start">
          <!-- Mobile menu -->
          <div class="dropdown">
            <label tabindex="0" class="btn btn-ghost lg:hidden" aria-label="Menu">
              <Icon name="lucide:menu" class="w-5 h-5" />
            </label>
            <ul
              tabindex="0"
              class="menu menu-sm dropdown-content mt-3 z-10 w-56 p-2 bg-base-100 rounded-box shadow-xl border border-base-300/50"
            >
              {
                navItems.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      class:list={[
                        'nav-link',
                        item.match(currentPath) && 'bg-primary/10 text-primary font-medium',
                      ]}
                      data-match={
                        item.label === 'Home'
                          ? 'home'
                          : item.label === 'Gallery'
                            ? 'gallery'
                            : item.label === 'My Badges'
                              ? 'mybadges'
                              : item.label.toLowerCase()
                      }
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
              <li class="menu-title mt-1"><span>Community</span></li>
              <li>
                <a
                  href="https://github.com/sponsors/kannansuresh"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-pink-500"
                >
                  <Icon name="lucide:heart" class="w-4 h-4" /> Sponsor
                </a>
              </li>
            </ul>
          </div>

          <!-- Logo -->
          <a href={base} class="flex items-center text-xl font-bold gap-2.5">
            <div class="w-9 h-9 rounded-lg bg-primary/10 flex items-center justify-center">
              <img src={`${base}favicon.svg`} alt="BadgeForge" class="w-6 h-6" />
            </div>
            <span class="hidden sm:inline">Badge<span class="text-primary">Forge</span></span>
          </a>
        </div>

        <!-- Desktop nav -->
        <div class="navbar-center hidden lg:flex">
          <ul class="menu menu-horizontal px-1 gap-1">
            {
              navItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      'nav-link rounded-lg transition-colors',
                      item.match(currentPath)
                        ? 'bg-primary/10 text-primary font-semibold'
                        : 'hover:bg-base-200',
                    ]}
                    data-match={
                      item.label === 'Home'
                        ? 'home'
                        : item.label === 'Gallery'
                          ? 'gallery'
                          : item.label === 'My Badges'
                            ? 'mybadges'
                            : item.label.toLowerCase()
                    }
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Right actions -->
        <div class="navbar-end gap-1">
          <Search />
          <div class="tooltip tooltip-bottom hidden sm:inline-flex" data-tip="Sponsor 💖">
            <a
              href="https://github.com/sponsors/kannansuresh"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost btn-circle text-pink-500"
              aria-label="Sponsor"
            >
              <Icon name="lucide:heart" class="w-5 h-5" />
            </a>
          </div>
          <div class="tooltip tooltip-bottom hidden sm:inline-flex" data-tip="GitHub">
            <a
              href="https://github.com/kannansuresh/badge-forge"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost btn-circle"
              aria-label="GitHub"
            >
              <Icon name="lucide:github" class="w-5 h-5" />
            </a>
          </div>
          <ThemeController />
        </div>
      </div>
    </header>

    <!-- Main -->
    <main class="flex-1" data-pagefind-body>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-base-300/50 bg-base-200/50" data-pagefind-ignore>
      <div class="max-w-7xl mx-auto px-4 py-12">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8">
          <!-- Brand -->
          <div>
            <div class="flex items-center gap-2 mb-3">
              <div class="w-8 h-8 rounded-lg bg-primary/10 flex items-center justify-center">
                <img src={`${base}favicon.svg`} alt="" class="w-5 h-5" />
              </div>
              <span class="font-bold text-lg">Badge<span class="text-primary">Forge</span></span>
            </div>
            <p class="text-sm text-base-content/60 leading-relaxed">
              A local-first, privacy-respecting badge builder. No accounts, no tracking — everything
              stays in your browser.
            </p>
          </div>

          <!-- Links -->
          <div>
            <h4 class="font-semibold mb-3">Links</h4>
            <ul class="space-y-2 text-sm text-base-content/70">
              <li><a href={`${base}forge`} class="link link-hover">Forge</a></li>
              <li><a href={`${base}gallery`} class="link link-hover">Gallery</a></li>
              <li><a href={`${base}my-badges`} class="link link-hover">My Badges</a></li>
              <li><a href={`${base}categories`} class="link link-hover">Categories</a></li>
            </ul>
          </div>

          <!-- Powered by -->
          <div>
            <h4 class="font-semibold mb-3">Powered By</h4>
            <ul class="space-y-2 text-sm text-base-content/70">
              <li>
                <a href="https://shields.io" target="_blank" class="link link-hover">shields.io</a>
              </li>
              <li>
                <a href="https://simpleicons.org" target="_blank" class="link link-hover"
                  >Simple Icons</a
                >
              </li>
              <li>
                <a href="https://astro.build" target="_blank" class="link link-hover">Astro</a>
              </li>
              <li>
                <a href="https://daisyui.com" target="_blank" class="link link-hover">DaisyUI</a>
              </li>
            </ul>
          </div>
        </div>

        <div class="border-t border-base-300/50 mt-8 pt-6 text-center text-xs text-base-content/40">
          <p>
            &copy; {new Date().getFullYear()} BadgeForge. Built by <a
              href="https://github.com/kannansuresh/"
              class="link link-hover"
              target="_blank">Kannan Suresh</a
            >. Open source under MIT.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  import { applyTheme } from '../lib/theme';
  import { initNav } from '../lib/nav';
  applyTheme();
  initNav();
</script>
