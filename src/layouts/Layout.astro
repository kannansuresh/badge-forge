---
import ThemeController from '../components/ThemeController';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'BadgeCraft — Build Beautiful Shields.io Badges',
  description = 'Create, customize, and browse stunning markdown/HTML badges powered by shields.io. Local-first, developer-focused.',
  ogImage = '/og-default.png',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-base-100 text-base-content flex flex-col">
    <!-- ── Navbar ──────────────────────────────────────── -->
    <header class="navbar bg-base-100 border-b border-base-300 sticky top-0 z-50 backdrop-blur-sm bg-base-100/80">
      <div class="navbar-start">
        <!-- Mobile menu toggle -->
        <div class="dropdown">
          <label tabindex="0" class="btn btn-ghost lg:hidden">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
            </svg>
          </label>
          <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-10 p-2 shadow-lg bg-base-100 rounded-box w-52">
            <li>
              <a href="/" class={currentPath === '/' ? 'active' : ''}>Home</a>
            </li>
            <li>
              <a href="/builder" class={currentPath === '/builder' ? 'active' : ''}>Live Studio</a>
            </li>
            <li>
              <a href="/gallery" class={currentPath.startsWith('/gallery') ? 'active' : ''}>Gallery</a>
            </li>
            <li>
              <a href="/dashboard" class={currentPath === '/dashboard' ? 'active' : ''}>My Backpack</a>
            </li>
          </ul>
        </div>

        <!-- Logo -->
        <a href="/" class="btn btn-ghost text-xl font-bold gap-2 normal-case">
          <span class="text-primary">🛡️</span>
          <span>BadgeCraft</span>
        </a>
      </div>

      <!-- Desktop nav links -->
      <div class="navbar-center hidden lg:flex">
        <ul class="menu menu-horizontal px-1 gap-1">
          <li>
            <a href="/builder" class={currentPath === '/builder' ? 'active' : ''}>Live Studio</a>
          </li>
          <li>
            <a href="/gallery" class={currentPath.startsWith('/gallery') ? 'active' : ''}>Gallery</a>
          </li>
          <li>
            <a href="/dashboard" class={currentPath === '/dashboard' ? 'active' : ''}>
              My Backpack
            </a>
          </li>
        </ul>
      </div>

      <div class="navbar-end gap-2">
        <!-- GitHub link -->
        <a
          href="https://github.com/shieldsio/badgecraft"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost btn-circle"
          aria-label="GitHub"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
          </svg>
        </a>

        <!-- Theme toggle -->
        <ThemeController client:load />
      </div>
    </header>

    <!-- ── Main Content ──────────────────────────────────── -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- ── Footer ────────────────────────────────────────── -->
    <footer class="footer footer-center p-10 bg-base-200 text-base-content">
      <div>
        <p class="font-bold text-lg">
          🛡️ BadgeCraft
        </p>
        <p class="text-base-content/60 max-w-md">
          A developer-focused, local-first tool for creating stunning badges powered by{' '}
          <a href="https://shields.io" target="_blank" rel="noopener noreferrer" class="link link-primary">shields.io</a>.
          All data stored securely in your browser.
        </p>
      </div>
      <div class="flex flex-wrap gap-4 text-sm">
        <a href="/builder" class="link link-hover">Live Studio</a>
        <span>·</span>
        <a href="/gallery" class="link link-hover">Gallery</a>
        <span>·</span>
        <a href="/dashboard" class="link link-hover">My Backpack</a>
      </div>
      <div>
        <p class="text-xs text-base-content/40">
          Built with Astro · React · Tailwind CSS · DaisyUI · Dexie.js · Simple Icons
        </p>
      </div>
    </footer>
  </body>
</html>
