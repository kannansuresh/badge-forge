---
import { Icon } from 'astro-icon/components';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import ThemeController from '../components/ThemeController.astro';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const title = Astro.props.title || 'BadgeForge — Build Beautiful Shields.io Badges';
const description =
  Astro.props.description ||
  'Create, customize, and browse stunning markdown/HTML badges powered by shields.io. Local-first, developer-focused.';
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Prevent theme flash: apply saved theme before first paint -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const t =
          stored === 'dark' || stored === 'light'
            ? stored
            : matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
        document.documentElement.setAttribute('data-theme', t);
        // Restore theme after client-side navigations (ClientRouter swaps content)
        document.addEventListener('astro:after-swap', () => {
          const s = localStorage.getItem('theme');
          if (s === 'dark' || s === 'light') {
            document.documentElement.setAttribute('data-theme', s);
          }
        });
      })();
    </script>

    <ClientRouter />

    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />

    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-base-100 text-base-content flex flex-col font-sans">
    <!-- Navbar -->
    <div class="navbar bg-base-100 border-b border-base-300 sticky top-0 z-50 backdrop-blur-sm">
      <div class="navbar-start">
        <!-- Mobile dropdown -->
        <div class="dropdown">
          <div tabindex="0" role="button" class="btn btn-ghost lg:hidden" aria-label="Toggle menu">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h8m-8 6h16"></path>
            </svg>
          </div>
          <ul
            tabindex="0"
            class="menu menu-sm dropdown-content bg-base-100 rounded-box z-10 mt-3 w-52 p-2 shadow"
          >
            <li><a href="/" class:list={['', currentPath === '/' && 'menu-active']}>Home</a></li>
            <li>
              <a href="/builder" class:list={['', currentPath === '/builder' && 'menu-active']}
                >Forge</a
              >
            </li>
            <li>
              <a
                href="/gallery"
                class:list={['', currentPath.startsWith('/gallery') && 'menu-active']}>Gallery</a
              >
            </li>
            <li>
              <a href="/dashboard" class:list={['', currentPath === '/dashboard' && 'menu-active']}
                >My Badges</a
              >
            </li>
          </ul>
        </div>

        <a href="/" class="btn btn-ghost text-xl font-bold gap-2">
          <img src="/favicon.svg" alt="" class="w-6 h-6" />
          BadgeForge
        </a>
      </div>

      <div class="navbar-center hidden lg:flex">
        <ul class="menu menu-horizontal px-1 gap-1">
          <li>
            <a href="/builder" class:list={['', currentPath === '/builder' && 'menu-active']}
              >Forge</a
            >
          </li>
          <li>
            <a
              href="/gallery"
              class:list={['', currentPath.startsWith('/gallery') && 'menu-active']}>Gallery</a
            >
          </li>
          <li>
            <a href="/dashboard" class:list={['', currentPath === '/dashboard' && 'menu-active']}
              >My Badges</a
            >
          </li>
        </ul>
      </div>

      <div class="navbar-end gap-1 pr-2">
        <a
          href="https://github.com"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost btn-circle"
          aria-label="GitHub"
        >
          <Icon name="lucide:github" class="w-5 h-5" />
        </a>
        <ThemeController />
      </div>
    </div>

    <!-- Main -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-base-300 bg-base-100 text-base-content/50 text-xs text-center py-4">
      <span>
        BadgeForge by <a href="https://github.com/kannansuresh/" class="link link-hover" target="_blank">Kannan Suresh</a>
        &mdash; Powered by <a href="https://shields.io" class="link link-hover" target="_blank">shields.io</a> &amp; <a href="https://simpleicons.org" class="link link-hover" target="_blank">Simple Icons</a>
      </span>
    </footer>
  </body>
</html>
