---
// GalleryBadgeDetail — Astro component for SSG gallery badge detail pages

import { Icon } from 'astro-icon/components';
import BadgeDetailView from './BadgeDetailView.astro';

const {
  categorySlug,
  categoryName,
  dexieSlug,
  label,
  message,
  color,
  logo,
  logoColor,
  logoSize,
  style: badgeStyle,
  labelColor,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const clipboardData = JSON.stringify({
  label,
  message,
  color,
  logo,
  logoColor,
  style: badgeStyle || 'flat',
  labelColor,
  categorySlug,
  categoryPath: categorySlug,
}).replace(/"/g, '&quot;');
---

<BadgeDetailView
  label={label}
  message={message}
  color={color}
  logo={logo}
  logoColor={logoColor}
  logoSize={logoSize}
  style={badgeStyle}
  labelColor={labelColor}
>
  <!-- Header slot -->
  <a
    slot="header"
    href={`${base}gallery/${categorySlug}`}
    class="inline-flex items-center gap-2 text-sm text-base-content/60 hover:text-base-content transition-colors mb-6"
  >
    <Icon name="lucide:arrow-left" class="w-4 h-4" /> Back to {categoryName}
  </a>

  <!-- Subtitle slot -->
  <p slot="subtitle" class="text-sm text-base-content/50 mt-1">
    From <a href={`${base}gallery/${categorySlug}`} class="link link-hover">{categoryName}</a> gallery
  </p>

  <!-- Actions slot -->
  <button
    slot="actions"
    class="btn btn-sm btn-primary gap-1"
    data-save-badge
    data-clipboard={clipboardData}
    data-dexie-slug={dexieSlug || categorySlug}
  >
    <Icon name="lucide:bookmark" class="w-3.5 h-3.5" /> Add to My Badges
  </button>
  <button
    slot="actions"
    class="btn btn-sm btn-outline gap-1"
    data-edit-badge
    data-clipboard={clipboardData}
  >
    <Icon name="lucide:pencil" class="w-3.5 h-3.5" /> Edit
  </button>
  <!-- Hidden icon registry for JS innerHTML swaps (symbols referenced via <use href="#ai:lucide:...">) -->
  <span style="display:none" aria-hidden="true">
    <Icon name="lucide:check" />
  </span>
</BadgeDetailView>

<script>
  import { initGalleryDetailActions, initSaveButtonState } from '../lib/gallery-detail';

  // Initialize save button (check if already saved, attach click handler)
  initGalleryDetailActions();
  initSaveButtonState();

  // Edit button: set sessionStorage before navigating to Forge
  function setupEditButton(): void {
    const btn = document.querySelector<HTMLElement>('[data-edit-badge]');
    if (!btn) return;
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      const raw = btn.getAttribute('data-clipboard') || '{}';
      // Browser auto-decodes &quot; entities in attributes, but we handle both cases
      const decoded = raw.includes('&quot;') ? raw.replace(/&quot;/g, '"') : raw;
      sessionStorage.setItem('badgeforge-clipboard', decoded);
      window.location.href = import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'forge';
    });
  }
  setupEditButton();
  document.addEventListener('astro:page-load', setupEditButton);
</script>
