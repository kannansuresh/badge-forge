---
// GalleryBadgeDetail — Astro component for SSG gallery badge detail pages

import BadgeDetailView from './BadgeDetailView.astro';

const {
  categorySlug,
  categoryName,
  dexieSlug,
  label,
  message,
  color,
  logo,
  logoColor,
  logoSize,
  style: badgeStyle,
  labelColor,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const clipboardData = JSON.stringify({
  label,
  message,
  color,
  logo,
  logoColor,
  style: badgeStyle || 'flat',
  labelColor,
  categorySlug,
  categoryPath: categorySlug,
}).replace(/"/g, '&quot;');
---

<BadgeDetailView
  label={label}
  message={message}
  color={color}
  logo={logo}
  logoColor={logoColor}
  logoSize={logoSize}
  style={badgeStyle}
  labelColor={labelColor}
>
  <!-- Header slot -->
  <a
    slot="header"
    href={`${base}gallery/${categorySlug}`}
    class="inline-flex items-center gap-2 text-sm text-base-content/60 hover:text-base-content transition-colors mb-6"
  >
    <svg class="w-4 h-4"><use href="#ai:lucide:arrow-left"></use></svg> Back to {categoryName}
  </a>

  <!-- Subtitle slot -->
  <p slot="subtitle" class="text-sm text-base-content/50 mt-1">
    From <a href={`${base}gallery/${categorySlug}`} class="link link-hover">{categoryName}</a> gallery
  </p>

  <!-- Actions slot -->
  <button
    slot="actions"
    class="btn btn-sm btn-primary gap-1"
    data-save-badge
    data-clipboard={clipboardData}
    data-dexie-slug={dexieSlug || categorySlug}
  >
    <svg class="w-3.5 h-3.5"><use href="#ai:lucide:bookmark"></use></svg> Save
  </button>
  <button
    slot="actions"
    class="btn btn-sm btn-outline gap-1"
    data-edit-badge
    data-clipboard={clipboardData}
  >
    <svg class="w-3.5 h-3.5"><use href="#ai:lucide:pencil"></use></svg> Edit
  </button>
</BadgeDetailView>

<script>
  import { saveBadge, isDuplicate, seedDefaultCategories, getAllCategories } from '../lib/storage';
  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

  function getData(el: Element) {
    const raw = (el.getAttribute('data-clipboard') || '{}').replace(/&quot;/g, '"');
    return JSON.parse(raw);
  }

  // ── Save button ──────────────────────────────────────
  document.querySelectorAll('[data-save-badge]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const slug = btn.getAttribute('data-dexie-slug') || '';
      try {
        await seedDefaultCategories();
        const cats = await getAllCategories();
        const match = cats.find((c: any) => c.slug === slug);
        const categoryId = match?.id;
        const data = getData(btn);
        const dup = await isDuplicate({
          ...data,
          logo: data.logo || '',
          logoColor: data.logoColor || '',
          logoSize: '',
          style: data.style || 'flat',
          labelColor: data.labelColor || '',
          categoryId,
        });
        if (dup) {
          btn.classList.add('btn-disabled');
          btn.innerHTML =
            '<svg class="w-3.5 h-3.5"><use href="#ai:lucide:bookmark"/></svg> Already saved';
          return;
        }
        await saveBadge({
          ...data,
          logo: data.logo || '',
          logoColor: data.logoColor || '',
          logoSize: '',
          style: data.style || 'flat',
          labelColor: data.labelColor || '',
          categoryId,
        });
        btn.classList.add('btn-success');
        btn.innerHTML = '<svg class="w-3.5 h-3.5"><use href="#ai:lucide:check"/></svg> Saved';
        setTimeout(() => {
          btn.classList.remove('btn-success');
          btn.classList.add('btn-primary');
          btn.innerHTML = '<svg class="w-3.5 h-3.5"><use href="#ai:lucide:bookmark"/></svg> Save';
        }, 2000);
      } catch {
        /* already saved */
      }
    });
  });

  // ── Edit button ──────────────────────────────────────
  document.querySelectorAll('[data-edit-badge]').forEach((btn) => {
    btn.addEventListener('click', () => {
      sessionStorage.setItem(
        'badgeforge-clipboard',
        btn.getAttribute('data-clipboard')?.replace(/&quot;/g, '"') || '{}',
      );
      window.location.href = `${base}forge`;
    });
  });
</script>
