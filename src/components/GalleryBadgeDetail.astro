---
// GalleryBadgeDetail — Astro component for SSG gallery badge detail pages

import { Icon } from 'astro-icon/components';
import BadgeDetailView from './BadgeDetailView.astro';

const {
  categorySlug,
  categoryName,
  dexieSlug,
  label,
  message,
  color,
  logo,
  logoColor,
  logoSize,
  style: badgeStyle,
  labelColor,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const clipboardData = JSON.stringify({
  label,
  message,
  color,
  logo,
  logoColor,
  style: badgeStyle || 'flat',
  labelColor,
  categorySlug,
  categoryPath: categorySlug,
}).replace(/"/g, '&quot;');
---

<BadgeDetailView
  label={label}
  message={message}
  color={color}
  logo={logo}
  logoColor={logoColor}
  logoSize={logoSize}
  style={badgeStyle}
  labelColor={labelColor}
>
  <!-- Header slot -->
  <a
    slot="header"
    href={`${base}gallery/${categorySlug}`}
    class="inline-flex items-center gap-2 text-sm text-base-content/60 hover:text-base-content transition-colors mb-6"
  >
    <Icon name="lucide:arrow-left" class="w-4 h-4" /> Back to {categoryName}
  </a>

  <!-- Subtitle slot -->
  <p slot="subtitle" class="text-sm text-base-content/50 mt-1">
    From <a href={`${base}gallery/${categorySlug}`} class="link link-hover">{categoryName}</a> gallery
  </p>

  <!-- Actions slot -->
  <button
    slot="actions"
    class="btn btn-sm btn-primary gap-1"
    data-save-badge
    data-clipboard={clipboardData}
    data-dexie-slug={dexieSlug || categorySlug}
  >
    <Icon name="lucide:bookmark" class="w-3.5 h-3.5" /> Save
  </button>
  <button
    slot="actions"
    class="btn btn-sm btn-outline gap-1"
    data-edit-badge
    data-clipboard={clipboardData}
  >
    <Icon name="lucide:pencil" class="w-3.5 h-3.5" /> Edit
  </button>
  <!-- Hidden icon registry for JS innerHTML swaps (symbols referenced via <use href="#ai:lucide:...">) -->
  <span style="display:none" aria-hidden="true">
    <Icon name="lucide:check" />
  </span>
</BadgeDetailView>

<script>
  import { saveBadge, isDuplicate, seedDefaultCategories, getAllCategories } from '../lib/storage';
  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

  function getData(el: Element) {
    const raw = (el.getAttribute('data-clipboard') || '{}').replace(/&quot;/g, '"');
    return JSON.parse(raw);
  }

  // Attach via event delegation — works regardless of ClientRouter navigation
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    const saveBtn = target.closest('[data-save-badge]') as HTMLElement | null;
    const editBtn = target.closest('[data-edit-badge]') as HTMLElement | null;

    if (saveBtn) {
      e.preventDefault();
      const slug = saveBtn.getAttribute('data-dexie-slug') || '';
      try {
        await seedDefaultCategories();
        const cats = await getAllCategories();
        const match = cats.find((c: any) => c.slug === slug);
        const categoryId = match?.id;
        const data = getData(saveBtn);
        const dup = await isDuplicate({
          ...data,
          logo: data.logo || '',
          logoColor: data.logoColor || '',
          logoSize: '',
          style: data.style || 'flat',
          labelColor: data.labelColor || '',
          categoryId,
        });
        if (dup) {
          saveBtn.classList.add('btn-disabled');
          saveBtn.innerHTML =
            '<svg class="w-3.5 h-3.5"><use href="#ai:lucide:bookmark"/></svg> Already saved';
          return;
        }
        await saveBadge({
          ...data,
          logo: data.logo || '',
          logoColor: data.logoColor || '',
          logoSize: '',
          style: data.style || 'flat',
          labelColor: data.labelColor || '',
          categoryId,
        });
        saveBtn.classList.add('btn-success');
        saveBtn.innerHTML = '<svg class="w-3.5 h-3.5"><use href="#ai:lucide:check"/></svg> Saved';
        setTimeout(() => {
          saveBtn.classList.remove('btn-success');
          saveBtn.classList.add('btn-primary');
          saveBtn.innerHTML =
            '<svg class="w-3.5 h-3.5"><use href="#ai:lucide:bookmark"/></svg> Save';
        }, 2000);
      } catch {
        /* already saved */
      }
      return;
    }

    if (editBtn) {
      e.preventDefault();
      sessionStorage.setItem(
        'badgeforge-clipboard',
        editBtn.getAttribute('data-clipboard')?.replace(/&quot;/g, '"') || '{}',
      );
      window.location.href = `${base}forge`;
    }
  });
</script>
