---
import { Icon } from 'astro-icon/components';
import { getSnippet, COPY_FORMATS } from '../lib/formats';
import type { CopyFormatKey } from '../lib/formats';

export interface Props {
  id: string;
  label: string;
  message: string;
  color: string;
  logo?: string;
  logoColor?: string;
  style?: 'flat' | 'flat-square' | 'plastic' | 'for-the-badge' | 'social';
  labelColor?: string;
  /** File-path-based category identifier for URL routing (e.g., "ai-bots"). */
  categoryPath?: string;
  /** JSON categorySlug for Dexie category seeding reference. */
  categorySlug?: string;
}

const {
  label,
  message,
  color,
  logo,
  logoColor,
  style = 'flat',
  labelColor,
  categoryPath,
  categorySlug,
} = Astro.props;

const params = new URLSearchParams();
params.set('label', label);
params.set('message', message);
params.set('color', color);
if (logo) params.set('logo', logo);
if (logoColor) params.set('logoColor', logoColor);
params.set('style', style);
if (labelColor) params.set('labelColor', labelColor);

const esc = (s: string) => encodeURIComponent(s.replace(/-/g, '--').replace(/_/g, '__'));
const shieldsUrl = `https://img.shields.io/badge/${esc(label)}-${esc(message)}-${color}?style=${style}${logo ? `&logo=${logo}` : ''}${logoColor ? `&logoColor=${logoColor}` : ''}${labelColor ? `&labelColor=${labelColor}` : ''}`;

// Pre-compute snippets for quick-copy buttons
const quickSnippets: Record<CopyFormatKey, string> = {} as Record<CopyFormatKey, string>;
for (const { key } of COPY_FORMATS) {
  quickSnippets[key] = getSnippet(key, shieldsUrl);
}

const clipboardData = JSON.stringify({
  label,
  message,
  color,
  logo,
  logoColor,
  style,
  labelColor,
  categorySlug,
  categoryPath,
});
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const detailUrl = `${base}gallery/${categoryPath || categorySlug}/${Astro.props.id}`;
---

<div
  class="card bg-base-100 border border-base-300/50 card-lift group overflow-hidden"
  data-badgecard
>
  <!-- Floating edit button — appears on hover -->
  <div
    class="absolute top-2 right-2 z-10 opacity-40 hover:opacity-100 transition-opacity flex gap-1"
  >
    <div class="tooltip tooltip-left [&::before]:text-[10px]" data-tip="Edit in Forge">
      <button
        class="btn btn-xs btn-ghost hover:bg-base-100/80"
        data-edit
        data-clipboard={clipboardData}
      >
        <Icon name="lucide:pencil" class="w-3 h-3" />
      </button>
    </div>
  </div>

  <!-- Badge preview — the hero of the card -->
  <a href={detailUrl} class="bg-base-200/50 px-5 py-6 flex items-center justify-center">
    <img
      src={shieldsUrl}
      alt={`${label || message}`}
      class="h-7 group-hover:scale-105 transition-transform"
      loading="lazy"
      onerror="this.parentElement.innerHTML='<span class=&quot;font-mono text-xs text-base-content/40&quot;>${label}-${message}-${color}</span>'"
    />
  </a>

  <div class="card-body p-4 gap-2">
    <!-- Title = message (since most gallery badges have empty labels) -->
    <h3 class="text-sm font-semibold truncate">
      <a href={detailUrl} class="group-hover:text-primary transition-colors">
        {message}
      </a>
    </h3>

    <!-- Meta row: color swatch + logo name -->
    <div class="flex items-center gap-2 text-xs text-base-content/50">
      <span class="inline-flex items-center gap-1">
        <span class="w-3 h-3 rounded-sm inline-block" style={`background-color:#${color}`}></span>
        <span class="font-mono text-xs">#{color}</span>
      </span>
      {logo && <span class="badge badge-ghost badge-xs font-normal">{logo}</span>}
    </div>

    <!-- Actions -->
    <div class="card-actions justify-center mt-2 pt-2 border-t border-base-300/30">
      <div class="join join-horizontal">
        {
          COPY_FORMATS.map(({ key, label: lbl }) => (
            <button
              class="join-item btn btn-xs btn-ghost px-2"
              data-copy={key}
              data-content={quickSnippets[key]}
              title={`Copy ${lbl}`}
            >
              {lbl}
            </button>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  import { initGalleryBadgeCards } from '../lib/dom.ts';
  document.addEventListener('astro:page-load', initGalleryBadgeCards);
</script>
