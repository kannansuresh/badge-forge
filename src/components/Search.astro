---
import { Icon } from 'astro-icon/components';
---

<div id="badgeforge-search" class="relative">
  <label
    class="input input-bordered flex items-center gap-2 w-32 xs:w-40 sm:w-56 md:w-64"
    for="search-input"
  >
    <Icon name="lucide:search" class="w-4 h-4 opacity-50 shrink-0" />
    <input
      id="search-input"
      type="text"
      class="grow bg-transparent outline-none text-sm w-0 min-w-0"
      placeholder="Search…"
      autocomplete="off"
    />
    <kbd class="kbd kbd-xs hidden sm:inline-flex opacity-50">⌘K</kbd>
  </label>

  <!-- Pagefind results drawer -->
  <div
    id="search-results"
    class="absolute top-full mt-2 right-0 w-72 sm:w-96 bg-base-100 border border-base-300 rounded-box shadow-xl hidden z-50 max-h-[70vh] overflow-y-auto"
  >
  </div>
</div>

<script>
  import { initSearch } from '../lib/search';
  initSearch();
  document.addEventListener('astro:page-load', initSearch);
</script>
