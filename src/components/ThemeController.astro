---
import { Icon } from 'astro-icon/components';
---

<label class="btn btn-ghost btn-circle swap swap-rotate" aria-label="Toggle theme">
  <input id="theme-toggle" type="checkbox" class="theme-controller" value="dark" />
  <!-- Sun -->
  <Icon name="lucide:sun" class="swap-off h-5 w-5" />
  <!-- Moon -->
  <Icon name="lucide:moon" class="swap-on h-5 w-5" />
</label>

<script>
  import { initThemeListeners, syncCheckbox } from '../lib/theme';

  // Sync checkbox on initial load
  syncCheckbox('theme-toggle');

  // Handle SPA navigation
  initThemeListeners();
</script>
