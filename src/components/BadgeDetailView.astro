---
// BadgeDetailView — Astro component for badge detail pages (zero JS by default)
// Only injects vanilla JS for interactive features: zoom toggle, copy to clipboard, embed expand

import { Icon } from 'astro-icon/components';
import { buildShieldsUrl, toAsciiDoc, toHtml, toMarkdown, toRst, toTextile } from '../lib/storage';

export interface Props {
  label: string;
  message: string;
  color: string;
  logo?: string;
  logoColor?: string;
  logoSize?: string;
  style?: string;
  labelColor?: string;
}

const {
  label,
  message,
  color,
  logo,
  logoColor,
  logoSize,
  style: styleProp,
  labelColor,
} = Astro.props;
const style = styleProp || 'flat';

const shieldsUrl = buildShieldsUrl({
  label,
  message,
  color,
  logo,
  logoColor,
  logoSize,
  style,
  labelColor,
});

const formats: { key: string; label: string }[] = [
  { key: 'md', label: 'Markdown' },
  { key: 'html', label: 'HTML' },
  { key: 'url', label: 'URL' },
  { key: 'rst', label: 'reST' },
  { key: 'asciidoc', label: 'AsciiDoc' },
  { key: 'textile', label: 'Textile' },
];

// Pre-compute all snippets server-side
const snippets: Record<string, string> = {
  md: toMarkdown(shieldsUrl),
  html: toHtml(shieldsUrl),
  url: shieldsUrl,
  rst: toRst(shieldsUrl),
  asciidoc: toAsciiDoc(shieldsUrl),
  textile: toTextile(shieldsUrl),
};
---

<!-- Header slot renders before the card -->
<slot name="header" />

<!-- Unified detail card -->
<div class="card bg-base-100 border border-base-300/50 overflow-hidden" data-badge-detail>
  <!-- Badge preview hero -->
  <div class="bg-base-200/50 px-6 py-14 flex items-center justify-center relative">
    <img
      src={shieldsUrl}
      alt={`${label}: ${message}`}
      class="transition-transform duration-200"
      style={`transform: scale(1); transform-origin: center;`}
      data-zoom-img
      onerror="this.parentElement.innerHTML='<span class=&quot;font-mono text-sm text-base-content/50&quot;>${label}-${message}-${color}</span>'"
    />
    <!-- Zoom controls -->
    <div
      class="join join-horizontal absolute bottom-3 right-3 opacity-70 hover:opacity-100 transition-opacity"
      data-zoom-controls
    >
      <button class="join-item btn btn-xs btn-active gap-1" data-zoom="1" title="Actual size">
        <Icon name="lucide:zoom-out" class="w-3 h-3" /> Actual
      </button>
      <button class="join-item btn btn-xs btn-ghost gap-1" data-zoom="2" title="Magnified (2x)">
        <Icon name="lucide:zoom-in" class="w-3 h-3" /> Magnified
      </button>
    </div>
  </div>

  <!-- Card body -->
  <div class="p-6 space-y-5">
    <!-- Title row -->
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <div class="min-w-0">
        <h1 class="text-xl font-bold truncate">{label ? `${label}: ${message}` : message}</h1>
        <slot name="subtitle" />
      </div>
      <div class="flex gap-2 shrink-0">
        <slot name="actions" />
      </div>
    </div>

    <!-- Metadata row -->
    <div class="flex flex-wrap items-center gap-3 text-sm text-base-content/60">
      <span class="inline-flex items-center gap-1.5">
        <span
          class="w-3.5 h-3.5 rounded-sm border border-base-content/20"
          style={`background-color:#${color}`}></span>
        <span class="font-mono text-xs">#{color}</span>
      </span>
      {logo && <span class="badge badge-ghost badge-sm font-normal">{logo}</span>}
      <span class="badge badge-outline badge-sm">{style}</span>
      {
        labelColor && (
          <span class="inline-flex items-center gap-1">
            <span
              class="w-3 h-3 rounded-sm border border-base-content/20"
              style={`background-color:#${labelColor}`}
            />
            <span class="text-xs">label #{labelColor}</span>
          </span>
        )
      }
    </div>

    <!-- Embed code -->
    <div class="border-t border-base-300/30 pt-4">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-sm font-semibold flex items-center gap-1.5">
          <Icon name="lucide:code-2" class="w-4 h-4" /> Embed
        </h2>
        <button class="btn btn-xs btn-ghost" data-expand-toggle>All formats</button>
      </div>
      <div class="flex flex-wrap gap-2" data-quick-buttons>
        {
          formats.slice(0, 3).map(({ key, label: lbl }) => (
            <button class="btn btn-xs btn-outline gap-1" data-copy={key}>
              <Icon name="lucide:copy" class="w-3 h-3" /> {lbl}
            </button>
          ))
        }
      </div>
      <div class="space-y-2 mt-3 hidden" data-expanded-code>
        {
          formats.map(({ key, label: lbl }) => (
            <div class="bg-base-200 rounded-btn p-3">
              <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-semibold text-base-content/50">{lbl}</span>
                <button class="btn btn-xs btn-ghost" data-copy={key}>
                  <Icon name="lucide:copy" class="w-3 h-3" /> Copy
                </button>
              </div>
              <pre class="text-xs font-mono text-base-content/80 overflow-x-auto whitespace-pre-wrap break-all">
                <code>{snippets[key]}</code>
              </pre>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<script>
  // ── Zoom toggle ─────────────────────────────────────
  document.querySelectorAll('[data-zoom]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const zoom = parseInt(btn.getAttribute('data-zoom') || '1');
      const img = document.querySelector('[data-zoom-img]') as HTMLElement | null;
      if (img) img.style.transform = `scale(${zoom})`;
      btn.parentElement?.querySelectorAll('[data-zoom]').forEach((b) => {
        b.classList.toggle('btn-active', b === btn);
        b.classList.toggle('btn-ghost', b !== btn);
      });
    });
  });

  // ── Copy to clipboard ──────────────────────────────
  document.querySelectorAll('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const key = btn.getAttribute('data-copy');
      // Get snippet from the pre code in expanded section, or the data-content attribute
      const pre = document
        .querySelector(`[data-expanded-code] [data-copy="${key}"]`)
        ?.closest('.bg-base-200')
        ?.querySelector('code');
      const text = pre?.textContent || '';
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.cssText = 'position:fixed;opacity:0;';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
      }
      const origHTML = btn.innerHTML;
      btn.innerHTML = '<svg class="w-3 h-3"><use href="#ai:lucide:check"/></svg> Copied';
      btn.classList.add('btn-success');
      btn.classList.remove('btn-outline', 'btn-ghost');
      setTimeout(() => {
        btn.innerHTML = origHTML;
        btn.classList.remove('btn-success');
        btn.classList.add('btn-outline');
      }, 2000);
    });
  });

  // ── Expand/collapse embed formats ──────────────────
  const expandToggle = document.querySelector('[data-expand-toggle]');
  const expanded = document.querySelector('[data-expanded-code]');
  if (expandToggle && expanded) {
    expandToggle.addEventListener('click', () => {
      const isHidden = expanded.classList.toggle('hidden');
      expandToggle.textContent = isHidden ? 'All formats' : 'Show less';
    });
  }
</script>
